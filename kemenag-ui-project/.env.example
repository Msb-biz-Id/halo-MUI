# Application Configuration
APP_NAME="Kemenag UI - Sistem Informasi Keagamaan"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kemenag_ui_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Email Configuration (PHPMailer)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@kemenag.go.id
MAIL_FROM_NAME="${APP_NAME}"

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# WhatsApp Configuration
# Option 1: WAHA (WhatsApp HTTP API)
WHATSAPP_PROVIDER=waha
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=your_waha_api_key
WAHA_SESSION_NAME=default

# Option 2: Fonnte
# WHATSAPP_PROVIDER=fonnte
# FONNTE_API_URL=https://api.fonnte.com
# FONNTE_TOKEN=your_fonnte_token

# Session Configuration
SESSION_LIFETIME=120
SESSION_DRIVER=file

# Security
APP_KEY=base64:your_32_character_random_string_here
CSRF_TOKEN_NAME=csrf_token
ENCRYPTION_KEY=your_encryption_key_here

# File Upload Configuration
MAX_FILE_SIZE=20971520
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx
UPLOAD_PATH=uploads/

# Pagination
ITEMS_PER_PAGE=20

# MFA Configuration
MFA_ISSUER=Kemenag UI
MFA_ENABLED=true

# Cache Configuration
CACHE_DRIVER=file
CACHE_LIFETIME=3600

# SEO Configuration
SEO_SITE_NAME="${APP_NAME}"
SEO_SITE_DESCRIPTION="Platform informasi keagamaan, help desk sertifikat halal, fatwa, dan materi moderasi beragama"
SEO_DEFAULT_IMAGE=/assets/images/og-image.jpg
SEO_TWITTER_HANDLE=@kemenag_ri

# Analytics
GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE_ID=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1
