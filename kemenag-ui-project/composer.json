{
    "name": "kemenag/ui-project",
    "description": "Website Magang Clone Kemenag UI - Sistem Informasi Keagamaan dengan Help Desk Sertifikat Halal",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Kemenag Development Team",
            "email": "dev@kemenag.go.id"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "phpmailer/phpmailer": "^6.8",
        "phpoffice/phpspreadsheet": "^1.29",
        "spomky-labs/otphp": "^10.0",
        "google/generative-ai-php": "^0.3",
        "guzzlehttp/guzzle": "^7.8",
        "tecnickcom/tcpdf": "^6.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "app/core/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
